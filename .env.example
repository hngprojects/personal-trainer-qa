# Personal Trainer (FitCall) — Staging QA credentials
# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.
# These are loaded by scripts/run.js and mapped into Postman variables.

# Base URL for the staging API (optional — defaults to the value in the env JSON)
BASE_URL=https://api.staging.fitcall.me/api/v1

# Admin account (drives the "0 SETUP" admin login -> admin_token)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Seeded trainer account (for /trainers/me* endpoints -> trainer_token)
TRAINER_EMAIL=
TRAINER_PASSWORD=
# Password used when completing trainer setup via POST /trainers/set-password
TRAINER_SETUP_PASSWORD=

# Test client account (register / verify-email / login flows -> client_token)
CLIENT_EMAIL=
CLIENT_PASSWORD=
# OTP received by email after registering — fill in before the verify-email step
CLIENT_OTP=
